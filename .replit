modules = ["nodejs-20", "postgresql-16", "python-base-3.13"]
[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "syntax"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node server.js"
waitForPort = 5000

[[workflows.workflow]]
name = "test"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm test"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "syntax"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node --check server.js && node --check Cheikh7/app.js && node --check Cheikh7/weekly.js && node --check Cheikh7/quiz-rules.js"

[workflows.workflow.metadata]
isValidation = true

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5055
externalPort = 3000

[[ports]]
localPort = 5197
externalPort = 3003

[[ports]]
localPort = 5198
externalPort = 3002

[[ports]]
localPort = 5199
externalPort = 3001

[deployment]
deploymentTarget = "autoscale"
run = ["node", "server.js"]
